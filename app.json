{
  "expo": {
    "name": "Master Sport",
    "slug": "mastersports",
    "version": "1.0.6",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/IconoFondoBlanco.png",
    "splash": {
      "image": "./assets/IconoMasterSports.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mastersport.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Master Sport necesita acceso a tus fotos para que puedas elegir y actualizar tu imagen de perfil.",
        "NSCameraUsageDescription": "Master Sport necesita acceso a la cámara para que puedas tomar una foto de perfil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/IconoAdaptiveAndroid.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mastersport.app",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "08f3107f-62e6-470c-ab2f-be595fa2dc33"
      }
    },
    "owner": "reich0319",
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Master Sport necesita acceso a tus fotos para que puedas elegir y actualizar tu imagen de perfil.",
          "cameraPermission": "Master Sport necesita acceso a la cámara para que puedas tomar una foto de perfil."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ]
  }
}
